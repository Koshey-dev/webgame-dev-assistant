# Ключ DeepSeek: без него в чате доступны только локальная модель и свой API.
DEEPSEEK_API_KEY=
# Модель DeepSeek.
DEEPSEEK_MODEL=deepseek-flash
# Локальная модель в Ollama.
LOCAL_MODEL=qwen2.5:1.5b
# Адрес Ollama.
OLLAMA_URL=http://127.0.0.1:11434
# Модель эмбеддингов (индекс и поиск).
EMBED_MODEL=embeddinggemma:300m-qat-q8_0
# Модель по умолчанию в чате: local | deepseek
DEFAULT_MODEL=deepseek
# SOCKS-прокси для облачных моделей (на VPS — узел VPN).
# LLM_PROXY=socks5://127.0.0.1:1080
# Порог косинуса для «в базе этого нет» (подобран контрольным набором).
RAG_THRESHOLD=0.54
# Порог косинуса для FAQ игр в разборе тикета.
FAQ_THRESHOLD=0.5
# Папка данных сервера: скачанные страницы, индекс, чаты, «Мой опыт». Пусто — data/ проекта.
# WDA_DATA=/var/lib/webgame-assistant
# Репозиторий, который видит MCP git. Пусто — корень проекта.
WDA_REPO=
# Файл CRM поддержки (JSON игроков и тикетов). Пусто — демо support/crm.json.
SUPPORT_CRM=
# Проект для /files (любой git-репозиторий). Пусто — репозиторий WDA_REPO.
FILES_ROOT=
# Читать тег или коммит вместо рабочей копии. Пусто — рабочая копия.
FILES_REF=
# Пути только для чтения, шаблоны через запятую. Пусто — knowledge/* (карточки правит автор).
FILES_READONLY=
# Токен ревью PR (GitHub Action → /api/review). Пусто — ревью выключено.
# Создать: openssl rand -hex 32; тот же токен — секрет REVIEW_TOKEN репозитория.
REVIEW_TOKEN=
