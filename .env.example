# Ключ DeepSeek: без него в чате доступны только локальная модель и свой API.
DEEPSEEK_API_KEY=
# Локальная модель в Ollama.
LOCAL_MODEL=qwen2.5:1.5b
# Модель по умолчанию в чате: local | deepseek
DEFAULT_MODEL=deepseek
# SOCKS-прокси для облачных моделей (на VPS — узел VPN).
# LLM_PROXY=socks5://127.0.0.1:1080
# Токен ревью PR (GitHub Action → /api/review). Пусто — ревью выключено.
# Создать: openssl rand -hex 32; тот же токен — секрет REVIEW_TOKEN репозитория.
REVIEW_TOKEN=
